    {
      "heading": "Model identity and source scope",
      "source_text": "Galaxy S Plus · GALAXY S Plus Specifications",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Connectivity",
      "source_text": "- 2G Network: GSM 850 / 900 / 1800 / 1900\n- 3G Network: HSPA 900 / 1900 / 2100\n- 3.5mm jack: Yes\n- WLAN: Wi-Fi 802.11 b/g/n, DLNA, Wi-Fi hotspot (Android 2.2)\n- Bluetooth: Yes, v3.0 with A2DP\n- USB: Yes, v2.0 MicroUSB",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Dimensions",
      "source_text": "- Dimensions: 122.4 x 64.2 x 9.9 mm\n- Weight: 119g",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Display",
      "source_text": "- Type: Super AMOLED capacitive Touchscreen, 16M colors\n- Size: 480 x 800 pixels, 4.0 inches",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Other technical specifications",
      "source_text": "- Alert types: Vibration; MP3, WAV ringtones\n- Loudspeaker: Yes\n- GPRS: Class 12 (4 1/3 2/2 3/1 4 slots), 32 - 48 kbps\n- EDGE: Class 12\n- 3G: HSPA , 14.4Mbps; HSUPA, 5.76Mbps\n- Features: Geo-tagging, touch focus, face and smile detection\n- Video: Yes, 720p@30fps\n- Messaging: SMS(threaded view), MMS, Email, Push Mail, IM, RSS\n- Browser: HTML\n- Radio: FM radio with RDS\n- GPS: Yes, with A-GPS support\n- Java: Via third party application",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Storage and memory",
      "source_text": "- Internal: 8 GB storage, 512 MB RAM, 2GB ROM\n- Card slot: MicroSD, up to 32GB, buy memory",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Camera",
      "source_text": "- Rear camera: 5 MP, 2592 x 1944 pixels, autofocus\n- Secondary: Yes, VGA",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Software",
      "source_text": "- OS: Android OS, v2.3 (Gingerbread)",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Processor",
      "source_text": "- CPU: 1.4 GHz processor",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    },
    {
      "heading": "Battery",
      "source_text": "- Stand-by: Standard battery, Li-Ion 1650 mAh",
      "source_url": "https://www.samsungmobilepress.com/media-assets/galaxy-s-plus?tab=specs",
      "source_file": "sources/samsung/galaxy-s/galaxy-s-plus-source.md"
    }
