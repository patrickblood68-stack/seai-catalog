{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEAI page evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourcePageId",
    "sourceUrl",
    "lastCheckedAt",
    "reviewBy",
    "sections"
  ],
  "properties": {
    "sourcePageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "lastCheckedAt": {
      "type": "string",
      "format": "date"
    },
    "reviewBy": {
      "type": "string",
      "format": "date"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "summary",
          "details"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
