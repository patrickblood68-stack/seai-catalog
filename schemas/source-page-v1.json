{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEAI source page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "markets", "language", "sourceUrl", "description", "headings", "snapshots", "relatedIds"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"const": "Sustainable Energy Authority of Ireland"},
    "markets": {"const": ["IE"]},
    "language": {"const": "en-IE"},
    "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://www\\.seai\\.ie/grants/home-energy-grants(?:/[^?#]+)?$"},
    "description": {"type": "string"},
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "title"],
        "properties": {"level": {"type": "integer", "minimum": 2, "maximum": 6}, "title": {"type": "string", "minLength": 1}}
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archivePath", "sha256"],
        "properties": {"archivePath": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    },
    "relatedIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
}
